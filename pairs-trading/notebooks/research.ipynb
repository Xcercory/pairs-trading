   "source": [
    "print(\"--- Первые 5 строк за 2007 год ---\")\n",
    "print(df.loc['2007'].head())\n",
    "\n",
    "print(\"\\n--- Последние 5 строк за 2023 ---\")\n",
    "print(df.tail())"
   ]
