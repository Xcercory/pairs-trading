    "import sys\n",
    "import os\n",
    "sys.path.append(os.path.abspath('..'))\n",
    "from src.data_loader import fetch_pair_data\n",
    "df = fetch_pair_data('NVDA','AMD','2007-01-01','2024-01-01')\n",
    "df.head()\n",
    "\n",
    "\n"
   ]
  },
