     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(12, 5))\n",
    "plt.plot(df.index, df['Zscore'], color='blue', label='Z-score')\n",
    "\n",
    "# Линии-пороги\n",
    "plt.axhline(0, color='black', linestyle='--', label='Среднее (0)')\n",
    "plt.axhline(2, color='red', linestyle='--', label='Верхний порог (+2) - Продаем спред')\n",
    "plt.axhline(-2, color='green', linestyle='--', label='Нижний порог (-2) - Покупаем спред')\n",
    "\n",
    "plt.title(\"Z-score спреда NVDA/AMD (30-дневное окно)\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "40833c25",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Сделок сгенерировано. Дней в лонге: 1070, Дней в шорте: 1351\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "# Создаем колонку для позиции (1 = лонг спреда, -1 = шорт спреда, 0 = вне рынка)\n",
    "df['Position'] = 0\n",
    "position = 0\n",
    "\n",
    "# Проходим циклом по всем дням\n",
    "for i in range(1, len(df)):\n",
    "    z = df['Zscore'].iloc[i]\n",
    "    \n",
    "    # Логика входа и выхода\n",
    "    if position == 0:\n",
    "        if z > 2:\n",
    "            position = -1  # Шорт спреда (продаем NVDA, покупаем AMD)\n",
    "        elif z < -2:\n",
    "            position = 1   # Лонг спреда (покупаем NVDA, продаем AMD)\n",
    "    elif position == -1 and z <= 0:\n",
    "        position = 0       # Закрываем шорт, когда Z-score вернулся к 0\n",
    "    elif position == 1 and z >= 0:\n",
    "        position = 0       # Закрываем лонг, когда Z-score вернулся к 0\n",
    "        \n",
    "    df.iloc[i, df.columns.get_loc('Position')] = position\n",
    "\n",
    "print(f\"Сделок сгенерировано. Дней в лонге: {(df['Position'] == 1).sum()}, Дней в шорте: {(df['Position'] == -1).sum()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e1e51f38",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Бэктест завершен!\n"
     ]
    }
   ],
   "source": [
    "# Считаем дневную доходность каждой акции\n",
    "df['NVDA_ret'] = df['NVDA'].pct_change()\n",
    "df['AMD_ret'] = df['AMD'].pct_change()\n",
    "\n",
    "# Доходность нашей стратегии. \n",
    "# Если мы в шорте спреда (-1), мы зарабатываем, когда NVDA падает, а AMD растет.\n",
    "# Учитываем бету (сколько акций AMD мы держим на 1 акцию NVDA)\n",
    "df['Strategy_Ret'] = df['Position'].shift(1) * (df['NVDA_ret'] - beta * df['AMD_ret'])\n",
    "\n",
    "# Убираем пустые значения (первая строка)\n",
    "df = df.dropna()\n",
    "\n",
    "# Считаем накопленный капитал (Cumulative Returns)\n",
    "df['Cumulative_Market'] = (1 + df['Strategy_Ret']).cumprod()\n",
    "\n",
    "print(\"Бэктест завершен!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "72544e88",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
