   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--- Метрики стратегии ---\n",
      "Среднегодовая доходность: -3.84%\n",
      "Годовая волатильность: 33.00%\n",
      "Коэффициент Шарпа: -0.12\n"
     ]
    }
   ],
   "source": [
    "# Годовая доходность (предполагаем 252 торговых дня в году)\n",
    "annual_return = df['Strategy_Ret'].mean() * 252\n",
    "\n",
    "# Годовой риск (волатильность)\n",
    "annual_volatility = df['Strategy_Ret'].std() * np.sqrt(252)\n",
    "\n",
    "# Коэффициент Шарпа (Sharpe Ratio) - безрисковую ставку берем за 0 для простоты\n",
    "sharpe_ratio = annual_return / annual_volatility\n",
    "\n",
    "print(f\"--- Метрики стратегии ---\")\n",
    "print(f\"Среднегодовая доходность: {annual_return * 100:.2f}%\")\n",
    "print(f\"Годовая волатильность: {annual_volatility * 100:.2f}%\")\n",
    "print(f\"Коэффициент Шарпа: {sharpe_ratio:.2f}\")"
   ]
  }
 ],
