     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(12, 6))\n",
    "plt.plot(df.index, df['Cumulative_Market'], color='green', label='Стратегия Pairs Trading (NVDA/AMD)')\n",
    "\n",
    "# Для сравнения добавим график Buy & Hold NVDA\n",
    "df['NVDA_BuyHold'] = (1 + df['NVDA_ret']).cumprod()\n",
    "plt.plot(df.index, df['NVDA_BuyHold'], color='gray', alpha=0.5, label='Buy & Hold NVDA')\n",
    "\n",
    "plt.title(\"Сравнение доходности стратегии и покупки NVDA\")\n",
    "plt.xlabel(\"Дата\")\n",
    "plt.ylabel(\"Рост капитала (в разах)\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  },
  {
