   "source": [
    "import statsmodels.api as sm\n",
    "Y = df['NVDA']\n",
    "X = df['AMD']\n",
    "X_const = sm.add_constant(X)\n",
    "model = sm.OLS(Y, X_const).fit()\n",
    "beta = model.params['AMD']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "84cde879",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "# Считаем спред: реальная цена NVDA минус предсказанная\n",
    "df['Spread'] = df['NVDA'] - (beta * df['AMD'])\n",
    "# Рисуем график спреда\n",
    "plt.figure(figsize=(12, 5))\n",
    "plt.plot(df.index, df['Spread'], color='purple', label='Спред (NVDA - beta * AMD)')\n",
    "plt.axhline(df['Spread'].mean(), color='black', linestyle='--', label='Среднее значение')\n",
    "plt.title(\"Спред между NVDA и AMD (2007 - 2024)\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "603bed2c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Z-score успешно рассчитан!\n"
     ]
    }
   ],
   "source": [
    "\n",
    "window = 30\n",
    "# Считаем скользящее среднее и скользящее стандартное отклонение\n",
    "df['Spread_Mean'] = df['Spread'].rolling(window=window).mean()\n",
    "df['Spread_Std'] = df['Spread'].rolling(window=window).std()\n",
    "\n",
    "# Считаем Z-score\n",
    "df['Zscore'] = (df['Spread'] - df['Spread_Mean']) / df['Spread_Std']\n",
    "\n",
    "# Удаляем первые 30 строк, где Z-score не посчитался (там нет истории)\n",
    "df = df.dropna()\n",
    "\n",
    "print(\"Z-score успешно рассчитан!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dbcf9ef6",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
